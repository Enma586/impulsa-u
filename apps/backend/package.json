{
  "name": "@impulsau/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "demo": "pnpm build && node --env-file=.env dist/main-demo.js",
    "dev": "nest start --watch --entryFile main-todo --env-file .env",
