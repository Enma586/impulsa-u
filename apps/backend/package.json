    "test": "vitest run"
  },
  "dependencies": {
    "@impulsau/contracts": "workspace:*",
    "@impulsau/db": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/platform-socket.io": "12.4.0",
    "@nestjs/websockets": "12.4.0",
    "@socket.io/redis-adapter": "8.3.0",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@types/node": "24.19.2",
    "socket.io-client": "4.8.4",
    "vitest": "5.0.3"
