{
  "name": "@impulsau/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "generar": "drizzle-kit generate",
    "migrar": "pnpm build && node --env-file=../../apps/backend/.env dist/migrar-cli.js",
    "test": "vitest run",
    "verificar-migraciones": "pnpm build && node dist/verificacion/verificar-migraciones.js"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
