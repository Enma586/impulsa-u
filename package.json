{
  "name": "impulsau",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "arquitectura": "depcruise apps packages --config .dependency-cruiser.cjs",
    "formato": "prettier --check .",
    "verificar-migraciones": "pnpm --filter @impulsau/db verificar-migraciones",
    "verificar": "pnpm build && pnpm typecheck && pnpm lint && pnpm arquitectura && pnpm verificar-migraciones && pnpm test && pnpm formato",
    "infra:arriba": "docker compose -f infra/docker-compose.yml up -d",
    "infra:abajo": "docker compose -f infra/docker-compose.yml down",
    "prepare": "husky"
  },
  "prettier": "./packages/config/prettier.json",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,cjs}": "prettier --write"
  },
  "devDependencies": {
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
